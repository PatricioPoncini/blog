---
import PageLayout from '@layouts/PageLayout.astro'
import TopLayout from '@layouts/TopLayout.astro'
import BottomLayout from '@layouts/BottomLayout.astro'
import { getLang, getLocalizedCollection, useTranslations } from '@i18n/utils'
import { formatMonthYear } from '@lib/utils'

const lang = getLang(Astro.url)
const WORK = useTranslations(lang).pages.work

const collection = await getLocalizedCollection('work', lang)

collection.sort(
  (a, b) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime()
)

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

function formatWorkDate(input: Date | string) {
  if (typeof input === 'string') return input
  return formatMonthYear(input, lang)
}
---

<PageLayout title={WORK.title} description={WORK.description}>
  <TopLayout>
    <div class="animate">
      <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
        {WORK.title}
      </h1>
      <div class="mt-1">
        {WORK.description}
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <ul>
      {
        work.map((entry) => (
          <li class="animate border-b border-black/10 dark:border-white/25 mt-4 py-8 first-of-type:mt-0 first-of-type:pt-0 last-of-type:border-none">
            <div class="text-sm uppercase mb-4">
              {formatWorkDate(entry.data.dateStart)} - {formatWorkDate(entry.data.dateEnd)}
            </div>

            <div class="text-black dark:text-white font-semibold">{entry.data.company}</div>

            <div class="text-sm font-semibold">{entry.data.role}</div>

            {entry.data.technologies && (
              <div class="flex flex-wrap gap-2 mt-4">
                {entry.data.technologies.map((tech) => (
                  <span class="px-2 py-1 text-[0.825rem] rounded-full bg-black/5 dark:bg-white/10 text-black dark:text-white whitespace-nowrap">
                    {tech}
                  </span>
                ))}
              </div>
            )}

            <article class="prose dark:prose-invert mt-4">
              <entry.Content />
            </article>
          </li>
        ))
      }
    </ul>
  </BottomLayout>
</PageLayout>
